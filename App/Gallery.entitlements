<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store requirement. Every folder read must happen inside a security-scoped
	     resource access token started from a user-granted bookmark. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- read-write, not read-only: trash/restore and drag-out need write access to
	     user-picked locations. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- Only ever used for CLGeocoder reverse geocoding of GPS albums. The app still
	     produces grid-named location albums with this stripped. -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Deliberately absent, see plan: com.apple.security.assets.pictures.read-write buys no UX
	     (TCC still prompts per folder), invites descending into Photos Library.photoslibrary, and
	     requires an App Review purpose string. PhotoKit keys are absent because we never touch
	     PHPhotoLibrary. -->
</dict>
</plist>
